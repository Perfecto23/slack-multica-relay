# Slack App 与准入范围。ID 使用逗号分隔；白名单可显式填写 all，黑名单优先。
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_TARGET_USER_IDS=
SLACK_TARGET_SUBTEAM_IDS=
# 必填。填写明确频道 ID；只有确实允许所有频道时才填写 all。
SLACK_ALLOWED_CHANNEL_IDS=
# 可选。即使 allowlist 为 all，这里的频道也不会触发。
SLACK_BLOCKED_CHANNEL_IDS=
# 留空等同 all；owner-only 部署必须填写明确的 User ID。
SLACK_ALLOWED_SENDER_IDS=
SLACK_BLOCKED_SENDER_IDS=
# Owner USER token，只用于 reaction acknowledgement。
SLACK_REACTION_TOKEN=
SLACK_REACTION_NAME=eyes

# 普通 Multica Issue API；无需 Autopilot 或 Webhook。
MULTICA_API_BASE_URL=https://multica.example.com
MULTICA_API_TOKEN=
MULTICA_WORKSPACE_ID=
MULTICA_PROJECT_ID=
MULTICA_AGENT_ID=

# 本项目专用 Redis：线程映射和写入确认状态，默认保留90天。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# QStash：持久化收件、后台投递、重试与失败保留。
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# 必须是当前部署公开的准确 URL，供发送和验签共同使用。
RELAY_CONSUMER_URL=https://relay.example.com/api/queue/consume
